# Copy to .env at the repository root for local configuration.
# Leave DB URLs absent to keep local SQLite. PostgreSQL deployment requires both.
# Neon runtime: pooled URL (hostname includes -pooler).
# Add connection_limit=2&pool_timeout=15&connect_timeout=15 to the supplied URL.
DATABASE_URL=
# Neon migration: direct URL (hostname does not include -pooler).
DIRECT_URL=
# Optional isolated PostgreSQL integration tests; never use real data as fixtures.
TEST_DATABASE_URL=

NODE_ENV=development
PORT=5000
# Production requires a private random secret of at least 32 characters.
JWT_SECRET=

# Browser-accessible server origin, without /api. Change to actual HTTPS deployment.
PAYMENT_PUBLIC_BASE_URL=http://10.0.2.2:5000
KAKAOPAY_SECRET_KEY=
KAKAOPAY_CID=
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
