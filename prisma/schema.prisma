// DB 연결 세팅

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model User {
  id             Int            @id @default(autoincrement()) @map("user_id")
  email          String         @unique
  password       String
  loginId        String         @unique @map("login_id")
  name           String
  ageGroup       String?        @map("age_group")
  memberType     String?        @map("member_type")
  memberDetail   String?        @map("member_detail")
  regionVerifiedAt DateTime? @map("region_verified_at")
  verifiedRegionCode String? @map("verified_region_code")
  region         String?
  point          Int            @default(0)
  createdAt      DateTime       @default(now()) @map("created_at")

  surveys        Survey[]       @relation("CreatedSurveys")
  responses      Response[]
  pointHistories PointHistory[]
  paymentOrders PaymentOrder[]
  coupons Coupon[]
  recruitments            Recruitment[]            @relation("CreatedRecruitments")
  recruitmentApplications RecruitmentApplication[]
  @@map("USER")
}

model Survey {
  id           Int        @id @default(autoincrement()) @map("survey_id")
  userId       Int        @map("user_id")
  title        String
  category     String?
  description  String?
  audience     String?
  duration     String?
  imageData    String?
  fundedReward Int       @default(0)
  rewardPoint  Int        @default(0) @map("reward_point")
  targetCount  Int        @default(0) @map("target_count")
  currentCount Int        @default(0) @map("current_count")
  status       String     @default("OPEN")
  endDate      DateTime?  @map("end_date")
  createdAt    DateTime   @default(now()) @map("created_at")

  author       User       @relation("CreatedSurveys", fields: [userId], references: [id], onDelete: Cascade)
  questions    Question[]
  responses    Response[]

  @@map("SURVEY")
}

model Question {
  id           Int            @id @default(autoincrement()) @map("question_id")
  surveyId     Int            @map("survey_id")
  question     String
  required     Boolean        @default(true)
  questionType String         @default("single") @map("question_type")

  survey       Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  options      SurveyOption[]
  answers      Answer[]

  @@map("QUESTION")
}

model SurveyOption {
  id         Int      @id @default(autoincrement()) @map("option_id")
  questionId Int      @map("question_id")
  optionText String   @map("option_text")

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("SURVEY_OPTION")
}

model Response {
  id        Int      @id @default(autoincrement()) @map("response_id")
  userId    Int      @map("user_id")
  surveyId  Int      @map("survey_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  survey    Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers   Answer[]

  @@unique([userId, surveyId])
  @@map("RESPONSE")
}

model Answer {
  id         Int      @id @default(autoincrement()) @map("answer_id")
  responseId Int      @map("response_id")
  questionId Int      @map("question_id")
  answer     String

  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("ANSWER")
}

model PointHistory {
  id             Int           @id @default(autoincrement()) @map("history_id")
  userId         Int           @map("user_id")
  amount         Int
  description    String
  createdAt      DateTime      @default(now()) @map("created_at")
  paymentOrderId String?       @unique @map("payment_order_id")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentOrder PaymentOrder? @relation(fields: [paymentOrderId], references: [id], onDelete: Restrict)

  recruitmentApplicationId Int? @unique
  recruitmentApplication RecruitmentApplication? @relation(fields: [recruitmentApplicationId], references: [id], onDelete: Restrict)

  @@map("POINT_HISTORY")
}

model PaymentOrder {
  id           String    @id @default(uuid())
  userId       Int       @map("user_id")
  provider     String
  amount       Int
  creditPoint  Int       @map("credit_point")
  status       String    @default("CREATED")
  providerRef  String?   @map("provider_ref")
  checkoutUrl  String?   @map("checkout_url")
  callbackHash String    @map("callback_hash")
  approvedAt   DateTime? @map("approved_at")
  creditedAt   DateTime? @map("credited_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  pointHistory PointHistory?

  @@unique([provider, providerRef])
  @@index([userId, createdAt])
  @@map("PAYMENT_ORDER")
}
model Coupon {
  id         String    @id @default(uuid())
  userId     Int       @map("user_id")
  itemId     String    @map("item_id")
  shop       String
  title      String
  cost       Int
  status     String    @default("AVAILABLE")
  requestKey String    @map("request_key")
  createdAt  DateTime  @default(now()) @map("created_at")
  usedAt     DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, requestKey])
  @@index([userId, createdAt])
  @@map("COUPON")
}

model Recruitment {
  id              Int      @id @default(autoincrement())
  authorId        Int
  title           String
  organization    String
  activityType    String
  participationMode String
  description     String
  eligibility     String
  location        String
  durationMinutes Int
  targetCount     Int
  acceptedCount   Int      @default(0)
  rewardPoint     Int      @default(0)
  fundedReward    Int      @default(0)
  remainingReward Int      @default(0)
  applicationDeadline DateTime
  status          String   @default("OPEN")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  author       User                     @relation("CreatedRecruitments", fields: [authorId], references: [id], onDelete: Restrict)
  slots        RecruitmentSlot[]
  applications RecruitmentApplication[]

  @@index([status, applicationDeadline])
  @@index([authorId, createdAt])
  @@map("RECRUITMENT")
}

model RecruitmentSlot {
  id            Int      @id @default(autoincrement())
  recruitmentId Int
  startsAt      DateTime
  endsAt        DateTime

  recruitment Recruitment              @relation(fields: [recruitmentId], references: [id], onDelete: Restrict)
  applications RecruitmentApplication[]

  @@index([recruitmentId, startsAt])
  @@map("RECRUITMENT_SLOT")
}

model RecruitmentApplication {
  id            Int       @id @default(autoincrement())
  recruitmentId Int
  userId        Int
  slotId        Int
  message       String?
  status        String    @default("APPLIED")
  agreedAt      DateTime
  selectedAt    DateTime?
  completedAt   DateTime?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  recruitment Recruitment     @relation(fields: [recruitmentId], references: [id], onDelete: Restrict)
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  slot        RecruitmentSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  pointHistory PointHistory?

  @@unique([recruitmentId, userId])
  @@index([userId, createdAt])
  @@index([recruitmentId, status])
  @@map("RECRUITMENT_APPLICATION")
}